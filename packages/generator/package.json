{
  "name": "@leaplearn/generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0 <21" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
